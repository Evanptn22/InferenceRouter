PORT=3000

# Provider credentials — only needed for the providers you actually call
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Payments (x402 + MPP) — see src/payments/.
# PAYMENT_MODE=mock keeps the built-in simulation running, no credentials needed.
# PAYMENT_MODE=live calls the real @inflowpayai/x402-seller + mpp-seller SDKs —
# requires INFLOW_API_KEY (both rails) and MPP_SECRET_KEY (balance rail only).
PAYMENT_MODE=mock
INFLOW_API_KEY=
INFLOW_ENVIRONMENT=sandbox
# 32+ bytes, HMAC-binds MPP challenges locally. Generate with: openssl rand -base64 32
MPP_SECRET_KEY=

# Used only when PAYMENT_MODE=mock:
X402_NETWORK=eip155:84532
X402_PAY_TO_ADDRESS=mock-seller-treasury
MPP_MERCHANT_ID=inflow-mock-merchant

INFLOW_BUYER_ID=inflow-router
USAGE_QUERY_PRICE_USD=0.0001
DEMO_STARTING_BALANCE_USD=1.0
