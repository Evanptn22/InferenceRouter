PORT=3000

# Provider credentials — only needed for the providers you actually call
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Payments (x402 + MPP) — see src/payments/.
# 'balance' (MPP) is a real internal-ledger transfer and is never mocked.
# 'exact' (x402) is mock-by-default; PAYMENT_MODE=live requires real
# facilitator credentials that aren't wired up yet (fails loudly with 501).
PAYMENT_MODE=mock
X402_NETWORK=eip155:84532
X402_PAY_TO_ADDRESS=mock-seller-treasury
MPP_MERCHANT_ID=inflow-mock-merchant
INFLOW_BUYER_ID=inflow-router
USAGE_QUERY_PRICE_USD=0.0001
DEMO_STARTING_BALANCE_USD=1.0
