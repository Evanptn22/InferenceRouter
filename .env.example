PORT=3000

# Provider credentials — only needed for the providers you actually call
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Demo consumer api keys (comma-separated pairs: key:consumerId)
# Falls back to a single "demo-key:demo" pair if unset — see src/config/consumers.js
ROUTER_API_KEYS=demo-key:demo
