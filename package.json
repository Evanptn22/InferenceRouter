    "@inflowpayai/mpp": "^0.7.1",
    "@inflowpayai/mpp-seller": "^0.6.2",
    "@inflowpayai/x402": "^0.8.1",
    "@inflowpayai/x402-seller": "^0.6.2",
    "@offering-protocol/agent": "^0.3.0",
    "@offering-protocol/core": "^0.3.5",
    "@offering-protocol/directory": "^0.2.4",
    "@offering-protocol/service": "^0.3.2",
    "@x402/evm": "^2.21.0",
    "@x402/fastify": "^2.21.0",
    "fastify": "^5.1.0",
    "mppx": "^0.8.15"
