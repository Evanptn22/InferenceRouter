{
  "name": "inference-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MVP inference router: routes chat-completion requests across a small provider catalog with flat metered pricing and basic reliability.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
